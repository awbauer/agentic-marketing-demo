<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Opens the Northstar Workbench app. Signing in still requires Cloudflare Access.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Northstar Workbench User</label>
    <applicationVisibilities>
        <application>Northstar_Workbench</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>NorthstarWorkbenchController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <tabSettings>
        <tab>Northstar_Workbench</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
