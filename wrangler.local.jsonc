{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "northstar-workbench-local",
  "main": "apps/edge/src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agent", "/agent/*", "/mcp/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MarketingOrchestrator", "class_name": "MarketingOrchestrator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MarketingOrchestrator"] }],
  "d1_databases": [{ "binding": "APP_DB", "database_name": "northstar-marketing-workbench-e2e" }],
  "r2_buckets": [{ "binding": "CAMPAIGN_ASSETS" }],
  // Real Workers AI from local dev, so the agents run on real models. The name differs from the
  // deployed Worker's, so the remote-bindings proxy does not hit the Access-protected domain.
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "ENVIRONMENT": "local",
    "AUTH_MODE": "development",
    "PROOF_WORKSPACE_ID": "northstar-demo",
    "AI_GATEWAY_ID": "northstar-marketing-pot",
    "CAMPAIGN_IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b"
  }
}
